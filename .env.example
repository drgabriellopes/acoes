# Synapse Colosseum — Environment Variables
# Copie para .env e preencha as chaves que desejar usar.

# Token de autenticacao (opcional — protege rotas /api/*)
COLOSSEUM_TOKEN=

# ── Provedores de LLM ──
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
DASHSCOPE_API_KEY=
MISTRAL_API_KEY=

# OpenRouter (gateway — modelos extras)
OPENROUTER_API_KEY=
